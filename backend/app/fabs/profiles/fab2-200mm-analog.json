                           {"cause": "heater element failing", "fix": "replace heater element", "mean_min": 240, "sd_min": 40}]},
       "BOAT": {"symptoms": ["boat elevator stalled", "wafer boat transfer error", "boat position alarm"],
                "causes": [{"cause": "elevator belt worn", "fix": "replace elevator belt", "mean_min": 90, "sd_min": 15},
                           {"cause": "position sensor misaligned", "fix": "realign position sensor", "mean_min": 45, "sd_min": 10}]}}},
    {"id": "thinfilm", "label": "Thin film", "prefix": "TFM", "area": [200, 10, 290, 80],
     "pm_task": "scheduled sputter PM: shields, target inspection and leak check",
     "faults": {
       "VAC": {"symptoms": ["chamber base pressure high", "leak check failed", "pump down too slow"],
               "causes": [{"cause": "door seal leaking", "fix": "replace chamber door seal", "mean_min": 70, "sd_min": 15},
                          {"cause": "cryo pump needs regeneration", "fix": "regenerate cryo pump", "mean_min": 150, "sd_min": 25}]},
       "THK": {"symptoms": ["film thickness drift", "sheet resistance out of spec", "deposition rate unstable"],
               "causes": [{"cause": "target erosion", "fix": "replace sputter target", "mean_min": 180, "sd_min": 30},
                          {"cause": "power supply arcing", "fix": "service DC power supply", "mean_min": 100, "sd_min": 20}]}}},
    {"id": "wet", "label": "Wet etch & clean", "prefix": "WET", "area": [10, 100, 100, 170],
     "pm_task": "scheduled wet bench PM: bath change and filter replacement",
     "faults": {
       "CHEM": {"symptoms": ["bath concentration out of range", "etch rate drift on monitor", "chemical dispense alarm"],
                "causes": [{"cause": "dispense pump failing", "fix": "replace dispense pump", "mean_min": 90, "sd_min": 15},
                           {"cause": "bath exhausted early", "fix": "dump and refill bath", "mean_min": 40, "sd_min": 8}]},
       "ROBOT": {"symptoms": ["wafer handler collision alarm", "cassette transfer error", "robot homing failed"],
                 "causes": [{"cause": "end effector misaligned", "fix": "reteach robot positions", "mean_min": 60, "sd_min": 12},
                            {"cause": "robot axis encoder fault", "fix": "replace axis encoder", "mean_min": 140, "sd_min": 25}]}}},
    {"id": "test", "label": "Parametric test", "prefix": "PTS", "area": [200, 100, 290, 170],
     "pm_task": "scheduled tester PM: probe card clean and calibration",
     "faults": {
       "PROBE": {"symptoms": ["probe contact resistance high", "yield drop on test wafers", "probe card alarm"],
