                           {"cause": "shutter timing fault", "fix": "replace shutter controller", "mean_min": 110, "sd_min": 20}]}}},
    {"id": "diffusion", "label": "Diffusion & furnaces", "prefix": "FUR", "area": [10, 10, 100, 80],
