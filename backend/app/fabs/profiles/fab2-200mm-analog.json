                          {"cause": "SMU module failing", "fix": "replace SMU module", "mean_min": 110, "sd_min": 20}]}}}
  ],
  "presets": {
    "normal": {"label": "Normal shift", "description": "Typical mix of PMs and tool-downs; staffing roughly matches load.",
