# Copy to backend/.env for local overrides. Every setting is optional: with nothing set
# the app uses SQLite (./data/fab.db) and an in-memory embedded Qdrant index, no keys needed.

# --- Authentication ---------------------------------------------------------------
# demo (default, local only: one-click Dispatcher/Viewer sign-in; refused in production)
# supabase (UAT/production: Supabase Auth; SUPABASE_URL etc. come from the Vercel integration)
# FAB_AUTH_MODE=supabase
# FAB_DISPATCHER_EMAILS=["lead@yourfab.com"]     # bootstrap dispatchers; others get FAB_DEFAULT_ROLE
# FAB_DEFAULT_ROLE=viewer
# FAB_DEFAULT_FABS=["*"]                          # fabs a user sees unless app_metadata.fabs says otherwise
# CRON_SECRET=                                    # protects /api/internal/prune (data retention)

# --- Fabs ----------------------------------------------------------------------------
# FAB_PROFILES_DIR=                               # extra/override fab profile JSONs (default: bundled)
# FAB_DEFAULT_FAB=fab1-300mm-logic

# --- Production persistence (optional) --------------------------------------------
# Any Postgres. For Supabase use the pooled "transaction" connection string (port 6543).
# FAB_DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Vector index for repair history (optional) ------------------------------------
# Unset = embedded Qdrant on local disk. Set to use a Qdrant server or Qdrant Cloud (free tier).
# FAB_QDRANT_URL=https://<cluster>.cloud.qdrant.io:6333
# FAB_QDRANT_API_KEY=

# --- Solver budgets ---------------------------------------------------------------
# FAB_ALNS_ITERATIONS=300          # deterministic stop for ALNS (see ANALYSIS: sizing the budget)
# FAB_PYVRP_ITERATIONS=1000        # deterministic stop for PyVRP
# FAB_SOLVER_TIME_LIMIT_S=3.0      # safety cap per solve
# FAB_LIVE_TIME_LIMIT_S=0.6        # cap per live re-plan

# --- Ops ------------------------------------------------------------------------------
# FAB_ENV=local                    # local | test | production
# FAB_LOG_JSON=false
# FAB_LOG_LEVEL=INFO
# FAB_CORS_ORIGINS=["http://localhost:5173"]
# FAB_SSE_WINDOW_S=25              # each SSE response closes after this; browsers reconnect
